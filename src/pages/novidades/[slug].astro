---
import { getEntry, render } from 'astro:content';
import { getPublishedNews } from '../../lib/news';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import NewsletterBand from '../../components/NewsletterBand.astro';
import { NEWS_TYPES, formatDate } from '../../lib/format';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const news = await getPublishedNews();
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const path = `/novidades/${entry.id}`;
const url = new URL(path, SITE.url).toString();
const credit = data.imageCredit ? await getEntry('credits', data.imageCredit) : undefined;

const kindLabel = { app: 'Abrir o app', cargas: 'Abrir o app de cargas', docs: 'Central de Ajuda' } as const;

// A imagem otimizada também serve de prévia para WhatsApp e redes.
import { getImage } from 'astro:assets';
const og = await getImage({ src: data.image, width: 1200, height: 630, format: 'jpg', fit: 'cover' });

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: data.title,
  description: data.summary,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  image: [new URL(og.src, SITE.url).toString()],
  inLanguage: 'pt-BR',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  author: { '@type': 'Organization', name: SITE.name, url: 'https://viafluvial.com.br' },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: new URL('/icons/viafluvial-icon-512.png', SITE.url).toString() },
  },
};

const shareText = encodeURIComponent(`${data.title} ${url}`);
const shareUrl = encodeURIComponent(url);
const shares = [
  { label: 'WhatsApp', href: `https://wa.me/?text=${shareText}` },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}` },
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}` },
  { label: 'X', href: `https://twitter.com/intent/tweet?text=${encodeURIComponent(data.title)}&url=${shareUrl}` },
];
---

<Base title={data.title} description={data.summary} path={path} type="article" image={og.src} publishedTime={data.pubDate.toISOString()} jsonLd={[articleJsonLd]}>
  <article class="section">
    <div class="wrap">
      <nav aria-label="Você está em" class="text-sm text-muted">
        <a href="/novidades" class="inline-flex min-h-11 items-center font-semibold text-green-700 hover:underline">← Todas as novidades</a>
      </nav>
      <header class="mt-2 max-w-3xl">
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
          <span class="rounded-full bg-green-100 px-2.5 py-0.5 font-bold text-green-800">{NEWS_TYPES[data.type]}</span>
          <time datetime={data.pubDate.toISOString()} class="text-muted">{formatDate(data.pubDate)}</time>
        </p>
        <h1 class="h1 mt-3 !text-[clamp(1.75rem,4.2vw,2.75rem)]">{data.title}</h1>
        <p class="lead mt-4">{data.summary}</p>
      </header>

      <figure class="mt-8 max-w-4xl overflow-hidden rounded-3xl bg-green-100 shadow-lg">
        <Picture
          src={data.image}
          formats={['avif', 'webp']}
    fallbackFormat="webp"
          widths={[480, 768, 1152]}
          sizes="(min-width: 1024px) 896px, 92vw"
          alt={data.imageAlt}
          loading="eager"
          fetchpriority="high"
          class="aspect-[16/9] h-auto w-full object-cover"
          pictureAttributes={{ class: 'block' }}
        />
        {credit && (
          <figcaption class="bg-white px-4 py-2 text-xs text-muted">
            <a href={`/creditos#${data.imageCredit}`} class="underline underline-offset-2">Foto: {credit.data.author} ({credit.data.license})</a>
          </figcaption>
        )}
      </figure>

      <div class="prose-vf mt-8" data-testid="news-body">
        <Content />
      </div>

      {
        data.links.length > 0 && (
          <aside class="mt-10 max-w-2xl rounded-2xl border border-line bg-surface p-6" aria-labelledby="links-relacionados">
            <h2 id="links-relacionados" class="font-extrabold text-green-900">Links relacionados</h2>
            <ul class="mt-3 space-y-1">
              {data.links.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center font-bold text-green-700 underline underline-offset-2">
                    {link.label}<span class="sr-only"> ({kindLabel[link.kind]}, abre em nova aba)</span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      <div class="mt-8 max-w-2xl">
        <h2 class="font-extrabold text-green-900">Compartilhar</h2>
        <ul class="mt-2 flex flex-wrap gap-2">
          {
            shares.map((share) => (
              <li>
                <a href={share.href} target="_blank" rel="noopener" class="btn btn-outline !min-h-11 !px-4">
                  {share.label}<span class="sr-only"> (abre em nova aba)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </article>

  <NewsletterBand />
</Base>
