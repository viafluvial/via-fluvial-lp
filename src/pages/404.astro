---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base
  title="Página não encontrada"
  description="Não encontramos a página que você procurou no site da Via Fluvial."
  path="/404"
  noindex
>
  <section class="section">
    <div class="wrap max-w-2xl text-center">
      <span class="icon-badge !h-16 !w-16"><Icon name="anchor" size={34} /></span>
      <h1 class="h1 mt-5 !text-[clamp(1.75rem,4vw,2.5rem)]">Página não encontrada</h1>
      <p class="lead mt-4">O endereço pode ter mudado ou não existir mais. Volte ao início ou escolha uma das páginas abaixo.</p>
      <p class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a href="/" class="btn btn-green">Página inicial</a>
        <a href="/novidades" class="btn btn-outline">Novidades</a>
        <a href="/contato" class="btn btn-outline">Contato</a>
      </p>
    </div>
  </section>
</Base>
