---
import Icon from './Icon.astro';
import SocialIcon from './SocialIcon.astro';
import { FOOTER_COLUMNS, LINKS, SITE, SOCIAL } from '../data/site';

const socials = SOCIAL.filter((item) => item.url);
const year = new Date().getFullYear();
---

<footer data-site-footer class="on-green bg-green-900 text-white">
  <div class="wrap py-12 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.3fr_2.7fr]">
      <div>
        <a href="/" class="inline-flex min-h-11 items-center gap-2.5 rounded-lg" aria-label="Via Fluvial - página inicial">
          <img src="/logo.svg" width="40" height="40" alt="" class="rounded-[10px]" loading="lazy" />
          <span class="text-xl font-extrabold tracking-tight">ViaFluvial<span class="text-yellow-400">Amazônia</span></span>
        </a>
        <p class="mt-4 max-w-xs text-[0.95rem] leading-relaxed text-green-100">
          Passagens, cargas e encomendas pelos rios da Amazônia.
        </p>
        <ul class="mt-5 space-y-2 text-[0.95rem]">
          <li>
            <a href={LINKS.mailto} class="inline-flex min-h-11 items-center gap-2 font-semibold hover:text-yellow-400">
              <Icon name="mail" size={18} />{SITE.email}
            </a>
          </li>
          <li>
            <a href={LINKS.whatsapp} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2 font-semibold hover:text-yellow-400">
              <Icon name="message-circle" size={18} />WhatsApp {SITE.whatsappDisplay}
            </a>
          </li>
        </ul>
        {
          socials.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-2" aria-label="Redes sociais">
              {socials.map((item) => (
                <li>
                  <a href={item.url} target="_blank" rel="noopener" aria-label={item.label} class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 hover:bg-white/20 hover:text-yellow-400">
                    <SocialIcon id={item.id} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <nav aria-label="Rodapé" class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4">
        {
          FOOTER_COLUMNS.map((column) => (
            <div>
              <p class="text-sm font-bold uppercase tracking-wider text-yellow-400">{column.title}</p>
              <ul class="mt-2">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="inline-flex min-h-11 items-center text-[0.95rem] text-green-100 hover:text-yellow-400 hover:underline"
                      {...(link.external ? { rel: 'noopener' } : {})}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="mt-10 border-t border-white/15 pt-6 text-sm leading-relaxed text-green-100">
      <p>Via Fluvial é uma plataforma da {SITE.company} - CNPJ {SITE.cnpj}</p>
      <p class="mt-1">© {year} Via Fluvial. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
