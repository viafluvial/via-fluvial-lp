---
import Icon from './Icon.astro';
import MobileMenu from './islands/MobileMenu';
import { LINKS, NAV_AFTER, NAV_MAIN, NAV_PARTNERS } from '../data/site';

interface Props {
  current: string;
}
const { current } = Astro.props;

const isActive = (href: string) => {
  if (href.startsWith('/#')) return false;
  return current === href || current.startsWith(`${href}/`);
};
const partnersActive = NAV_PARTNERS.some((item) => isActive(item.href));
const linkBase =
  'inline-flex items-center whitespace-nowrap min-h-11 px-2.5 rounded-lg text-[0.9rem] font-semibold text-white/95 hover:text-yellow-400 hover:bg-white/10 transition-colors';
---

<header data-site-header class="sticky top-0 z-[100] bg-green-700 text-white shadow-[0_2px_8px_rgb(0_0_0/0.18)]" style="height: var(--header-h)">
  <div class="on-green mx-auto flex h-full w-full max-w-[84rem] items-center justify-between gap-3 px-4 sm:px-6">
    <a href="/" class="flex min-h-11 items-center gap-2.5 rounded-lg" aria-label="Via Fluvial - página inicial">
      <img src="/logo.svg" width="36" height="36" alt="" class="rounded-[10px]" />
      <span class="text-[1.15rem] font-extrabold tracking-tight">ViaFluvial<span class="text-yellow-400 nav:max-[1439px]:hidden">Amazônia</span></span>
    </a>

    <nav aria-label="Principal" class="hidden nav:flex items-center gap-0.5">
      {NAV_MAIN.map((item) => <a href={item.href} class={linkBase}>{item.label}</a>)}
      <details class="relative" data-nav-group>
        <summary
          class:list={[linkBase, 'cursor-pointer gap-1', partnersActive && 'text-yellow-400']}
        >
          Para parceiros
          <Icon name="chevron-down" size={16} />
        </summary>
        <div class="absolute left-0 top-full z-10 mt-1 w-72 rounded-xl bg-white p-2 text-ink shadow-xl ring-1 ring-black/10">
          {NAV_PARTNERS.map((item) => (
            <a href={item.href} class="block min-h-11 rounded-lg px-3 py-2.5 font-semibold text-green-800 hover:bg-green-50" aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </div>
      </details>
      {
        NAV_AFTER.map((item) => (
          <a href={item.href} class:list={[linkBase, isActive(item.href) && 'text-yellow-400']} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href={LINKS.platform} class="btn btn-yellow hidden whitespace-nowrap !px-4 !text-[0.95rem] sm:inline-flex">Acessar a plataforma</a>
      <a href="/demonstracao" data-demo-open class="btn btn-outline-light hidden whitespace-nowrap !px-4 !text-[0.95rem] nav:inline-flex">Agendar demonstração</a>
      <MobileMenu
        client:load
        main={NAV_MAIN}
        partners={NAV_PARTNERS}
        after={NAV_AFTER}
        platformUrl={LINKS.platform}
      />
    </div>
  </div>
</header>

<script>
  // Grupo "Para parceiros": fecha ao clicar fora, ao apertar Esc ou ao sair com o Tab.
  const group = document.querySelector<HTMLDetailsElement>('[data-nav-group]');
  if (group) {
    document.addEventListener('click', (event) => {
      if (group.open && !group.contains(event.target as Node)) group.open = false;
    });
    group.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && group.open) {
        group.open = false;
        group.querySelector<HTMLElement>('summary')?.focus();
      }
    });
    group.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (group.open && next && !group.contains(next)) group.open = false;
    });
  }
</script>
